# Monorepo-root ignores — each app also has its own nested .gitignore, but this covers
# anything generated at the repo root before/outside those subfolders.
node_modules/
dist/
dist-ssr/
.next/
out/
build/
coverage/

# env files — never commit secrets
.env
.env.*
!.env.example

# editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# typescript / vercel
*.tsbuildinfo
next-env.d.ts
.vercel

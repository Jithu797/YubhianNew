rules_version = '2';

// Paste this into Firebase Console -> Firestore Database -> Rules, then Publish.
//
// Pattern used throughout: public content collections are readable by anyone (so the
// website can render without auth) and only writable by signed-in admins; the two
// "inbox" collections (leads, career_applications) are the reverse - anyone can create
// a new entry (so the public contact/waitlist/career forms work without login), but
// only signed-in admins can read, update, or delete them.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    } 

    // Public content - readable by anyone, writable only by signed-in admins.
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /team/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blogs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /product/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /clients/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /careers/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Inbox collections - public forms can create, only admins can read/manage.
    match /leads/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /career_applications/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /consent_logs/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
